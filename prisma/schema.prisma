generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Account {
  id        Int      @id @default(autoincrement())
  nama      String
  email     String   @unique
  password  String
  role      String   @default("user")
  jwt       String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@map("accounts")
}